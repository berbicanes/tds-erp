# Copy to deploy/.env on the server (never commit .env). chmod 600 deploy/.env

# Public domain; DNS A/AAAA record must point to the VPS. Caddy gets the HTTPS certificate.
TDS_DOMAIN=erp.example.ba

# Database password (long random string, e.g. `openssl rand -base64 32`).
POSTGRES_PASSWORD=

# First Admin login. Used only when no user with this name exists yet.
# After the first login you can remove the password from this file.
TDS_ADMIN_USERNAME=
TDS_ADMIN_PASSWORD=

# Host directory for uploaded files and auth cookie keys (bind-mounted into the api container).
# The api container runs as uid 1654 (APP_UID): chown -R 1654:1654 $TDS_DATA_DIR
TDS_DATA_DIR=/opt/tds/data

# --- backup.sh ---
# Local backup directory on the VPS (30-day rotation).
BACKUP_DIR=/opt/tds/backup
# Off-server copy: Hetzner Storage Box over rsync/SSH. Leave empty to keep only local backups
# (backup.sh then logs a warning).
BACKUP_RSYNC_HOST=
BACKUP_RSYNC_USER=
BACKUP_RSYNC_PATH=tds-backup
# Hetzner Storage Box uses SSH port 23.
BACKUP_RSYNC_PORT=23
BACKUP_SSH_KEY=/root/.ssh/tds_backup
